# Copy this file to .env.local and fill in real values. Never commit .env.local.

# MySQL database (create via cPanel "MySQL Databases", then run db/schema.sql
# and every db/migration-*.sql file against it, in filename order)
DB_HOST=
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASSWORD=

# Public URL of this app -- used to build links inside emails (password
# reset, portal access, OTP context)
APP_URL=http://localhost:3000

# SMTP (use a real mailbox, e.g. cPanel "Email Accounts" or your provider's
# transactional email service)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# 32-byte hex key used to encrypt borrower national ID numbers at rest
# (lib/crypto.ts). Generate one with: openssl rand -hex 32
ENCRYPTION_KEY=
